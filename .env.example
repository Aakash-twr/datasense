# DataSense API – Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# Application
APP_NAME="DataSense API"
APP_VERSION="0.3.0"
DEBUG=false
ENVIRONMENT=development

# Server
HOST=0.0.0.0
PORT=8000

# Database (PostgreSQL with psycopg 3 driver)
DATABASE_URL=postgresql+psycopg://datasense_user:your_secure_password@localhost:5432/datasense

# JWT Authentication & Tokens
# Generate a strong 32+ character random secret for production (e.g. `openssl rand -hex 32`)
JWT_SECRET_KEY=datasense-development-secret-change-in-production-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Cookie Configuration
REFRESH_COOKIE_NAME=datasense_refresh_token
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

# CORS – comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173

# Storage & Ingestion Limits (Phase 3)
DATA_STORAGE_ROOT=.local_storage/datasense
MAX_UPLOAD_SIZE_BYTES=26214400
MAX_DATASET_ROWS=500000
MAX_DATASET_COLUMNS=200
DEFAULT_PREVIEW_ROWS=100
MAX_PREVIEW_ROWS=500

# DuckDB Analytical Engine Settings (Phase 4)
DUCKDB_MEMORY_LIMIT=512MB
DUCKDB_THREADS=2
DUCKDB_QUERY_TIMEOUT_SECONDS=30
DUCKDB_MAX_RESULT_ROWS=2000
DUCKDB_MAX_DATASETS_PER_QUERY=10
DUCKDB_MAX_CONCURRENT_QUERIES=2
DUCKDB_TEMP_DIRECTORY=.local_storage/datasense/temp/duckdb

# Gemini AI Analytics Copilot (Phase 5)
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_TEMPERATURE=0.1
GEMINI_MAX_OUTPUT_TOKENS=4096
GEMINI_REQUEST_TIMEOUT_SECONDS=45
AI_ENABLED=true
AI_MAX_REQUESTS_PER_MINUTE=5
AI_MAX_CONVERSATION_MESSAGES=20
AI_MAX_SCHEMA_TABLES=50
AI_MAX_SCHEMA_COLUMNS=500

# Multi-Agent LangGraph Workflows (Phase 6)
AGENT_WORKFLOWS_ENABLED=true
AGENT_MAX_STEPS=15
AGENT_MAX_LLM_CALLS=8
AGENT_MAX_SQL_QUERIES=5
AGENT_MAX_CONCURRENT_RUNS=2
AGENT_WORKFLOW_TIMEOUT_SECONDS=180
AGENT_CHECKPOINT_RETENTION_DAYS=30
AGENT_MAX_PARALLEL_TASKS=2
AGENT_RESULT_CACHE_TTL_SECONDS=900
AGENT_DEFAULT_MODE=deep_analysis

# Phase 7: Pooling, Rate Limits & Observability
FRONTEND_URL=http://localhost:5173
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
LOG_LEVEL=INFO
STRUCTURED_LOGGING=false
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_PER_MINUTE=20
RATE_LIMIT_UPLOAD_PER_MINUTE=15
RATE_LIMIT_QUERY_PER_MINUTE=40
RATE_LIMIT_AI_PER_MINUTE=12
RATE_LIMIT_AGENT_PER_MINUTE=8
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
METRICS_TOKEN=


