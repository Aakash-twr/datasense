# DataSense Production Environment Template
# Copy to .env on your production server and replace ALL placeholder secrets.
# NEVER commit a populated .env file or development defaults to version control.

# Application
APP_NAME="DataSense API"
APP_VERSION="0.7.0"
ENVIRONMENT=production
DEBUG=false

# Server
HOST=0.0.0.0
PORT=8000
WEB_CONCURRENCY=1

# Database (PostgreSQL 14+ with psycopg 3 driver)
DATABASE_URL=postgresql+psycopg://datasense_user:CHANGE_ME_STRONG_DB_PASSWORD@postgres:5432/datasense
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Security & Authentication (REQUIRED: generate with `openssl rand -hex 32`)
JWT_SECRET_KEY=CHANGE_ME_GENERATE_AT_LEAST_32_CHARS_RANDOM_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Cookies (HTTPS mandatory in production)
REFRESH_COOKIE_NAME=datasense_refresh_token
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

# Frontend Origin & CORS (NO wildcard '*' allowed in production)
FRONTEND_URL=https://analytics.example.com
CORS_ORIGINS=https://analytics.example.com

# Storage & Upload Limits
DATA_STORAGE_ROOT=/var/lib/datasense/storage
MAX_UPLOAD_SIZE_BYTES=26214400
MAX_DATASET_ROWS=500000
MAX_DATASET_COLUMNS=200
DEFAULT_PREVIEW_ROWS=100
MAX_PREVIEW_ROWS=500

# DuckDB Analytical Engine
DUCKDB_MEMORY_LIMIT=512MB
DUCKDB_THREADS=2
DUCKDB_QUERY_TIMEOUT_SECONDS=30
DUCKDB_MAX_RESULT_ROWS=2000
DUCKDB_MAX_DATASETS_PER_QUERY=10
DUCKDB_MAX_CONCURRENT_QUERIES=2
DUCKDB_TEMP_DIRECTORY=/var/lib/datasense/storage/temp/duckdb

# Google Gemini AI Copilot
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_TEMPERATURE=0.1
GEMINI_MAX_OUTPUT_TOKENS=4096
GEMINI_REQUEST_TIMEOUT_SECONDS=45
AI_ENABLED=true
AI_MAX_REQUESTS_PER_MINUTE=5
AI_MAX_CONVERSATION_MESSAGES=20
AI_MAX_SCHEMA_TABLES=50
AI_MAX_SCHEMA_COLUMNS=500

# Multi-Agent LangGraph Workflows
AGENT_WORKFLOWS_ENABLED=true
AGENT_MAX_STEPS=15
AGENT_MAX_LLM_CALLS=8
AGENT_MAX_SQL_QUERIES=5
AGENT_MAX_CONCURRENT_RUNS=2
AGENT_WORKFLOW_TIMEOUT_SECONDS=180
AGENT_CHECKPOINT_RETENTION_DAYS=30
AGENT_MAX_PARALLEL_TASKS=2
AGENT_RESULT_CACHE_TTL_SECONDS=900
AGENT_DEFAULT_MODE=deep_analysis

# Rate Limiting & Observability
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_PER_MINUTE=20
RATE_LIMIT_UPLOAD_PER_MINUTE=15
RATE_LIMIT_QUERY_PER_MINUTE=40
RATE_LIMIT_AI_PER_MINUTE=12
RATE_LIMIT_AGENT_PER_MINUTE=8
LOG_LEVEL=INFO
STRUCTURED_LOGGING=true
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
METRICS_TOKEN=CHANGE_ME_OPTIONAL_PROMETHEUS_SCRAPE_TOKEN
